# oCMS Production Environment Example
# Copy to .env and replace placeholder values before deployment.

# REQUIRED: Server secret for CSRF protection (minimum 32 bytes; sessions are stored server-side)
# Generate with: openssl rand -base64 32
# The placeholder below is refused at startup.
OCMS_SESSION_SECRET=replace-with-strong-random-secret

# REQUIRED: Seals the authenticator-app secrets of two-factor authentication,
# which production requires for every account (OCMS_REQUIRE_MFA, on unless set
# to false). Minimum 32 bytes, distinct from OCMS_SESSION_SECRET.
# Generate with: openssl rand -base64 32
# Back it up with the database: without it, enrolled users can sign in only
# with recovery codes. The placeholder below is refused at startup.
OCMS_MFA_KEY=replace-with-strong-random-mfa-key

# REQUIRED: Server configuration
OCMS_SERVER_HOST=127.0.0.1
OCMS_SERVER_PORT=8082
OCMS_ENV=production
OCMS_LOG_LEVEL=warn
OCMS_ERROR_LOG_PATH=./logs/error.log

# Optional browser authorization for MCP (docs/oauth.md).
# Set a canonical HTTPS OCMS_SITE_URL before enabling OAuth.
# OCMS_OAUTH_ENABLED=false
# OCMS_OAUTH_CIMD_ALLOWED_HOSTS=claude.ai,chatgpt.com
# Optional owner-reviewed public client metadata JSON array (see docs/oauth.md).
# OCMS_OAUTH_PRE_REGISTERED_CLIENTS=
# OCMS_OAUTH_ALLOW_DCR=false
# Optional protected registration credential (generate with openssl rand -hex 32).
# OCMS_OAUTH_DCR_INITIAL_ACCESS_TOKEN=
# OCMS_OAUTH_ACCESS_TTL=3600
# OCMS_OAUTH_REFRESH_TTL_DAYS=30
# OCMS_AI_DISABLED=false
# Scratch probes are forbidden in production; leave disabled.
# OCMS_MCP_SPIKE_TOOLS=false

# REQUIRED: Keep seeding disabled in production
OCMS_DO_SEED=false

# REQUIRED: Database path (relative to WorkingDirectory)
OCMS_DB_PATH=./data/ocms.db

# REQUIRED: Theme configuration
# Core themes (default, developer) are embedded in the binary.
# Custom themes go in the custom/themes/ directory to override or extend core themes.
OCMS_CUSTOM_DIR=./custom
OCMS_ACTIVE_THEME=developer

# REQUIRED for GEOIP-enabled analytics in production
OCMS_GEOIP_DB_PATH=/var/local/geoip/GeoLite2-Country.mmdb

# REQUIRED for embed proxy in production when embed provider is enabled.
# Origin matching is exact (scheme + host). Include every public hostname
# that can serve chat (for example apex and www domains).
OCMS_EMBED_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# REQUIRED for embed proxy in production when embed provider is enabled.
# Use api.dify.ai for hosted Dify, or replace with your self-hosted API host.
OCMS_EMBED_ALLOWED_UPSTREAM_HOSTS=api.dify.ai

# Hardened policy for production embed proxy.
OCMS_REQUIRE_EMBED_ALLOWED_ORIGINS=true
OCMS_REQUIRE_EMBED_ALLOWED_UPSTREAM_HOSTS=true

# REQUIRED in production by embed module initialization.
# Generate with: openssl rand -base64 32
# The placeholder below is refused at startup.
OCMS_EMBED_PROXY_TOKEN=replace-with-embed-proxy-token

# Production security enforcement overrides.
# These flags auto-enable in production and block startup if requirements
# aren't met. Set to false to disable checks you don't need yet.
# Re-enable individually as you configure each feature.
# OCMS_REQUIRE_API_ALLOWED_CIDRS=false
# OCMS_REQUIRE_TRUSTED_PROXIES=false
# OCMS_REQUIRE_BLOCK_SUSPICIOUS_PAGE_HTML=false
# OCMS_REQUIRE_API_KEY_SOURCE_CIDRS=false
# OCMS_REQUIRE_API_KEY_EXPIRY=false
# OCMS_REQUIRE_WEBHOOK_ALLOWED_HOSTS=false
# OCMS_REQUIRE_EMBED_ALLOWED_UPSTREAM_HOSTS=false

# Optional: Redis for distributed caching
# OCMS_REDIS_URL=redis://localhost:6379/0

# Optional: hCaptcha for bot protection
# OCMS_HCAPTCHA_SITE_KEY=your-site-key
# OCMS_HCAPTCHA_SECRET_KEY=your-secret-key
# Force-disable hCaptcha (overrides database settings)
# OCMS_HCAPTCHA_DISABLED=false
