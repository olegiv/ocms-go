# Elefant CMS MySQL connection settings
ELEFANT_HOST=localhost
ELEFANT_PORT=3306
ELEFANT_USER=your_mysql_user
ELEFANT_PASSWORD=your_mysql_password
ELEFANT_DB=your_elefant_database
ELEFANT_PREFIX=elefant_
ELEFANT_FILES=/path/to/elefant/files

# Drupal 8-11 MySQL connection settings
DRUPAL_HOST=localhost
DRUPAL_PORT=3306
DRUPAL_USER=your_mysql_user
DRUPAL_PASSWORD=your_mysql_password
DRUPAL_DB=your_drupal_database
DRUPAL_PREFIX=
DRUPAL_FILES=/path/to/drupal/sites/default/files
# Public URL prefix for Drupal public:// files when it is not the detected
# /sites/<site>/files/ or /system/files/ form.
# DRUPAL_PUBLIC_FILES_URL=/sites/example/files/
# Drupal node bundle -> oCMS page type. Unlisted bundles become pages.
DRUPAL_TYPE_MAP=article:post,page:page
# Vocabularies imported as flat tags; every other vocabulary becomes categories.
DRUPAL_TAG_VOCABULARIES=tags

# PHP-Nuke MySQL connection settings
PHPNUKE_HOST=localhost
PHPNUKE_PORT=3306
PHPNUKE_USER=your_mysql_user
PHPNUKE_PASSWORD=your_mysql_password
PHPNUKE_DB=your_phpnuke_database
# PHP-Nuke's installer defaults to nuke_ but the prefix is chosen at setup time.
PHPNUKE_PREFIX=nuke_
# The PHP-Nuke document root, not an uploads subdirectory: story bodies
# reference images by paths relative to the site root.
PHPNUKE_FILES=/path/to/phpnuke/htdocs
# oCMS language that receives the imported content. Leave unset to use the site
# default. A PHP-Nuke database carries no usable language metadata, so a
# non-English site must name its language here — and that language must already
# exist and be active, or the import fails rather than writing into the wrong
# namespace.
# PHPNUKE_LANGUAGE=ru

# Trusted absolute roots for local media import. Submitted Files path values
# must equal or descend from one of these roots. DRUPAL_FILES, ELEFANT_FILES
# and PHPNUKE_FILES above are trusted too. Roots must exist and be directories; safe symlinks are
# canonicalized and filesystem-root targets are rejected. With no trusted root,
# database/content migration still works but local-media import fails closed.
# OCMS_MIGRATOR_ALLOWED_FILE_ROOTS=/srv/legacy-cms,/mnt/migration-media

# Optional: restrict which source database hosts the migrator may connect to.
# Comma-separated bare hostnames or IPs, no scheme and no port. Empty = no
# restriction (a CMS database being migrated usually lives on a private
# address, so private IPs are deliberately not blocked).
# Enforced by every source, not just one — see shared.BuildMySQLDSN.
# OCMS_MIGRATOR_ALLOWED_DB_HOSTS=db.internal,10.0.0.5

# In production this defaults to true: startup fails if the migrator module is
# active while the allowlist above is empty. Set it to false to opt out.
# OCMS_REQUIRE_MIGRATOR_ALLOWED_DB_HOSTS=true
