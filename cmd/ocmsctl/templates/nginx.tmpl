Nginx: paste into Plesk > Websites & Domains > {{.Domain}} > Apache & nginx
Settings > Additional nginx directives (and leave "Proxy mode" unchecked).

# oCMS reverse proxy to port {{.Port}}
location ~ ^/(.*)$ {
    # No URI after the port: with one, nginx rebuilds the request from the
    # decoded path and /a%20b.jpg reaches the app with a raw space (HTTP 400).
    proxy_pass http://127.0.0.1:{{.Port}};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    client_max_body_size 100M;
}

# Block access to hidden files
location ~ /\. {
    deny all;
}
