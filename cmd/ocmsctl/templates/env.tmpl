# oCMS configuration for {{.Domain}}
# Generated by ocmsctl on {{.Date}}

# Session secret (unique per site)
OCMS_SESSION_SECRET={{.Secret}}

# Seals the authenticator-app secrets of two-factor authentication, which
# production requires for every account (OCMS_REQUIRE_MFA). Keep it with the
# database backups: without it, enrolled users can sign in only with
# recovery codes.
OCMS_MFA_KEY={{.Secret}}

# Server
OCMS_SERVER_HOST=127.0.0.1
OCMS_SERVER_PORT={{.Port}}
OCMS_ENV=production
OCMS_LOG_LEVEL=warn
OCMS_ERROR_LOG_PATH=./logs/error.log

# Production safety
OCMS_DO_SEED=false
OCMS_REQUIRE_SEED_ADMIN_PASSWORD=true
OCMS_SEED_ADMIN_PASSWORD={{.HexSecret}}

# Database (relative to the site directory)
OCMS_DB_PATH=./data/ocms.db

# Custom themes. Core themes (default, developer) are embedded in the binary;
# themes in ./custom/themes/ override or extend them.
OCMS_CUSTOM_DIR=./custom
OCMS_ACTIVE_THEME=default

# Embed proxy hardening. Origin matching is exact (scheme + host); list every
# public hostname, comma-separated. Replace the upstream with a self-hosted
# Dify API host if needed.
OCMS_EMBED_ALLOWED_ORIGINS=https://{{.Domain}}
OCMS_EMBED_ALLOWED_UPSTREAM_HOSTS=api.dify.ai
OCMS_REQUIRE_EMBED_ALLOWED_ORIGINS=true
OCMS_REQUIRE_EMBED_ALLOWED_UPSTREAM_HOSTS=true
OCMS_EMBED_PROXY_TOKEN={{.Secret}}

# Optional: Redis
# OCMS_REDIS_URL=redis://localhost:6379/0

# Optional: hCaptcha
# OCMS_HCAPTCHA_SITE_KEY=your-site-key
# OCMS_HCAPTCHA_SECRET_KEY=your-secret-key
